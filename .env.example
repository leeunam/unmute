# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# Agora: console.agora.io → seu projeto → Configuração (Config).
# Só App ID e App Certificate: a REST API usa autenticação por token,
# então Customer ID/Secret não são necessários.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# LLM pelo gateway da feita.ai (https://feita.ai/ai-gateway). Chave em feita.ai → API Keys.
FEITA_API_KEY=
# Opcional. Padrão: nvidia/nemotron-3-super-120b-a12b (o mais rápido de ponta a ponta, ver TESTES.md).
# Alternativas: google/gemini-3.5-flash-lite (mais natural com tools), anthropic/claude-haiku-5.5.
FEITA_MODEL=

# Como a Agora chega ao LLM:
#   feita-proxy (padrão): Agora → túnel → nossa rota /api/llm/chat/completions (AI SDK) → feita.ai
#   feita-direto: Agora → gateway da feita.ai, sem passar por nós (base de comparação)
LLM_PROVIDER=feita-proxy
# Segredo que a Agora manda para a nossa rota de LLM. Gere com: openssl rand -hex 24
LLM_PROXY_SECRET=
# Opcional. Endereço público do app. Se vazio, usa o endereço pelo qual a página foi aberta
# (o do túnel do npm run tunel).
PUBLIC_URL=

# Opcional. Raciocínio do LLM em JSON. Padrão: {"enabled":false} quando o modelo deixa desligar
# (Haiku 5.5, Nemotron), {"effort":"minimal"} quando é obrigatório (Gemini, Sonnet/Opus/Fable).
FEITA_REASONING=

# Opcionais de voz.
# TTS: "cartesia" (padrão, sonic-3.6 gerenciado, ~0,09 s), "minimax" (gerenciado, ~0,25 s)
# ou "feita" (gateway da feita pelo generic_http).
TTS_VENDOR=
# Só com TTS_VENDOR=feita. Padrão: elevenlabs/eleven-flash-v2.5.
TTS_MODEL=
# Cartesia padrão: 9626c31c-bec5-4cca-baa8-f8ba9e84c8bc (Jacqueline). MiniMax padrão: Portuguese_FriendlyNeighbor.
# feita/ElevenLabs padrão: pNInz6obpgDQGcFmaJgB (Adam).
TTS_VOICE=
# Opcionais: trocam o bloco inteiro de tts ou asr enviado à Agora (JSON). Exemplos em TESTES.md, seção 7.
TTS_JSON=
ASR_JSON=
# Silêncio (ms) que o agente espera para considerar que você terminou. Padrão: 300.
VAD_SILENCE_MS=
