# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# Agora: console.agora.io → seu projeto → Configuração (Config).
# Só App ID e App Certificate: a REST API usa autenticação por token,
# então Customer ID/Secret não são necessários.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# LLM do agente: "claude" (padrão) ou "openai-gerenciado" (plano B, sem chave,
# usa a OpenAI gerenciada pela própria Agora).
LLM_PROVIDER=claude
# Anthropic: console.anthropic.com → API Keys. Obrigatória com LLM_PROVIDER=claude.
ANTHROPIC_API_KEY=
# Opcional. Padrão: claude-haiku-5-5 (o mais rápido, melhor para voz).
CLAUDE_MODEL=
# Opcional, só para LLM_PROVIDER=openai-gerenciado. Padrão: gpt-4.1-mini.
OPENAI_MODEL=

# Opcionais de ajuste de voz.
# Voz MiniMax (gerenciada pela Agora, sem chave). Padrão: Portuguese_FriendlyNeighbor.
TTS_VOICE=
# Silêncio (ms) que o agente espera para considerar que você terminou. Padrão: 480.
VAD_SILENCE_MS=

# Chave da feita.ai que veio com o projeto. Não é usada pelo agente (veja TESTES.md).
FEITA_API_KEY=
